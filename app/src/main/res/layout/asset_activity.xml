<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    >

    <!-- Container for added assets -->
    <LinearLayout
        android:id="@+id/container1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#f2f2f2">

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="Save" />

        <Button
            android:id="@+id/buttonAddAnother"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="8dp"
            android:text="Add"
            android:textColor="@android:color/black"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cccccc" />

    <!-- Input for Asset Number -->
    <EditText
        android:id="@+id/editTextAssetNumber1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Firearm barcode"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:inputType="text" />

    <!-- Input for Asset Description -->
    <EditText
        android:id="@+id/editTextAssetDescription1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="FirearmType"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:inputType="text" />
    <EditText
        android:id="@+id/editTextModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Firearm model"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:inputType="text" />
    <EditText
        android:id="@+id/requisitionEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Requisition number"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:inputType="text" />

    <!-- Save Button -->

    <!-- Add Another Asset Button -->
<!--    <Button-->
<!--        android:id="@+id/buttonSubmit"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_gravity="center_horizontal"-->
<!--        android:layout_marginTop="16dp"-->
<!--        android:text="Submit"-->
<!--        android:visibility="visible"/>-->

    <!-- FrameLayout to make toolbar full width -->
<!--    <FrameLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content">-->

<!--    </FrameLayout>-->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00bfff"
        app:menu="@drawable/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/black" />

</LinearLayout>

